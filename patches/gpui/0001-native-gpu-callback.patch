+    /// Register a domain-independent GPU renderer on this window.
+    #[cfg(target_os = "windows")]
+    pub fn register_gpu_renderer(
+        &mut self,
+        renderer: impl crate::NativeGpuRenderer,
+    ) -> Result<crate::NativeGpuHandle> {
+        let handle = crate::NativeGpuHandle::new(self.handle, renderer);
+        self.platform_window
