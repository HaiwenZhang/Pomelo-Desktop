+//! Domain-independent, window-scoped native GPU callbacks (D3D11 implementation).
+
+use crate::{AnyWindowHandle, Bounds, ContentMask, ScaledPixels};
+use std::{
+    any::Any,
+    fmt,
+    sync::{Arc, Mutex, Weak},
+};
+use windows::Win32::Graphics::Direct3D11::{ID3D11Device, ID3D11DeviceContext};
+
+/// Borrowed for one synchronous draw on the owning window's rendering thread.
+/// The callback must not present, retain the context, or issue work on another thread.
+pub struct NativeGpuContext<'a> {
+    /// GPUI's current device. Resources must be released on `reset`.
+    pub device: &'a ID3D11Device,
+    /// Immediate context with the window target and viewport already bound.
+    pub context: &'a ID3D11DeviceContext,
+    /// Physical pixel size of the window target.
+    pub viewport: [f32; 2],
+    /// Physical pixel element bounds.
+    pub bounds: Bounds<ScaledPixels>,
+    /// Effective parent clip; the callback must honor it.
+    pub content_mask: ContentMask<ScaledPixels>,
+}
+
+/// Implemented by application renderers; GPUI knows no geometry or shader formats.
+pub trait NativeGpuRenderer: Send + 'static {
+    /// Encode drawing using immutable per-frame application data.
+    fn draw(
+        &mut self,
+        context: &NativeGpuContext<'_>,
+        data: &(dyn Any + Send + Sync),
+    ) -> anyhow::Result<()>;
+    /// Release all device resources before device replacement or window destruction.
+    fn reset(&mut self);
+}
+
+struct RendererState {
+    renderer: Box<dyn NativeGpuRenderer>,
+    status: NativeGpuStatus,
+}
+
+/// Diagnostics for the registered renderer, independent of application terminology.
+#[derive(Clone, Debug, Default)]
+pub struct NativeGpuStatus {
+    /// Successful callback submissions.
+    pub submitted: u64,
+    /// Submissions followed by a successful window presentation.
+    pub presented: u64,
+    /// Device/window lifecycle reset notifications.
+    pub resets: u64,
+    /// Raw technical error; applications supply a localized user-facing summary.
+    pub last_error: Option<String>,
+}
+
+/// Cloneable registration retained by in-flight/cached scenes; dropping all handles releases it.
+#[derive(Clone)]
+pub struct NativeGpuHandle {
+    owner: AnyWindowHandle,
+    state: Arc<Mutex<RendererState>>,
+}
+
+impl fmt::Debug for NativeGpuHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("NativeGpuHandle")
+            .field("owner", &self.owner)
+            .finish_non_exhaustive()
+    }
+}
+
+impl NativeGpuHandle {
+    pub(crate) fn new(owner: AnyWindowHandle, renderer: impl NativeGpuRenderer) -> Self {
+        Self {
+            owner,
+            state: Arc::new(Mutex::new(RendererState {
+                renderer: Box::new(renderer),
+                status: NativeGpuStatus::default(),
+            })),
+        }
+    }
+    pub(crate) fn belongs_to(&self, owner: AnyWindowHandle) -> bool {
+        self.owner.window_id() == owner.window_id()
+    }
+    pub(crate) fn downgrade(&self) -> NativeGpuRegistration {
+        NativeGpuRegistration(Arc::downgrade(&self.state))
+    }
+    /// Read diagnostics without granting access to the underlying device.
+    pub fn status(&self) -> NativeGpuStatus {
+        self.state
+            .lock()
+            .unwrap_or_else(|error| error.into_inner())
+            .status
+            .clone()
+    }
+    /// Backend entry point. Not an application drawing API.
+    #[doc(hidden)]
+    pub fn invoke(
+        &self,
+        context: &NativeGpuContext<'_>,
+        data: &(dyn Any + Send + Sync),
+    ) -> anyhow::Result<()> {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        match state.renderer.draw(context, data) {
+            Ok(()) => {
+                state.status.submitted = state.status.submitted.saturating_add(1);
+                state.status.last_error = None;
+                Ok(())
+            }
+            Err(error) => {
+                state.status.last_error = Some(format!("{error:#}"));
+                Err(error)
+            }
+        }
+    }
+    /// Backend presentation acknowledgement.
+    #[doc(hidden)]
+    pub fn presented(&self) {
+        let mut state = self.state.lock().unwrap_or_else(|error| error.into_inner());
+        state.status.presented = state.status.submitted;
+    }
+}
+
+/// Weak lifecycle entry; the window registry does not keep dropped views alive.
+pub struct NativeGpuRegistration(Weak<Mutex<RendererState>>);
+impl NativeGpuRegistration {
+    /// Whether any scene or application still owns this renderer.
+    pub fn is_alive(&self) -> bool {
+        self.0.strong_count() > 0
+    }
+    /// Notify a live renderer that its device resources must be released.
+    pub fn reset(&self) {
+        if let Some(state) = self.0.upgrade() {
+            let mut state = state.lock().unwrap_or_else(|error| error.into_inner());
+            state.renderer.reset();
+            state.status.resets = state.status.resets.saturating_add(1);
+        }
+    }
+}
+
+/// A scene-ordered draw command with immutable, application-owned payload.
+#[derive(Clone)]
+pub struct NativeGpuPrimitive {
+    /// Window-scoped registration.
+    pub handle: NativeGpuHandle,
+    /// Immutable snapshot, retained until all referencing scenes are released.
+    pub data: Arc<dyn Any + Send + Sync>,
+}
+impl fmt::Debug for NativeGpuPrimitive {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("NativeGpuPrimitive")
+            .field("handle", &self.handle)
+            .finish_non_exhaustive()
+    }
+}
