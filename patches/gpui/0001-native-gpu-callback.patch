+struct NativeGpuStateRestore {
+    context: ID3D11DeviceContext1,
+    previous: Option<ID3DDeviceContextState>,
+}
+
+impl Drop for NativeGpuStateRestore {
+    fn drop(&mut self) {
+        // Also restore on callback errors or unwinding; never clear the window target.
+        if let Some(previous) = &self.previous {
+            // Release borrowed target bindings before resize or resource retirement.
+            unsafe {
+                self.context.ClearState();
+                self.context.SwapDeviceContextState(previous, None);
+            }
         }
     }
